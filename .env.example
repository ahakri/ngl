# Copy to .env and export before starting (or set these in your host's dashboard).
PORT=8080
PUBLIC_URL=http://localhost:8080
NODE_ENV=development
# DATABASE_PATH=./data/siteline.db
# TRUST_PROXY=1            # when behind a reverse proxy / load balancer
# COLLECT_HOUR_UTC=9       # daily collection time
# SCHEDULER=0              # disable the in-process scheduler (run `npm run collect` from cron instead)

# Billing — leave empty to run without checkout.
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
STRIPE_PRICE_PRO=
STRIPE_PRICE_TEAM=
# Shown as a "Contact sales" link when Stripe is not configured.
SALES_EMAIL=
