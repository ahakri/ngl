# Copy to .env and export before starting (or set these in your host's dashboard).
PORT=8080
PUBLIC_URL=http://localhost:8080
NODE_ENV=development
# DATABASE_PATH=./data/rangefinder.db
# TRUST_PROXY=1            # when behind a reverse proxy / load balancer

# Moderation. Accounts with these emails see the review queue and have full access.
ADMIN_EMAILS=
# AUTO_APPROVE=0           # hold every submission for review (default: only flagged ones wait)

# Billing — leave empty to run without checkout.
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
STRIPE_PRICE_PRO=
STRIPE_PRICE_TEAM=
# Shown as a "Contact sales" link when Stripe is not configured.
SALES_EMAIL=
