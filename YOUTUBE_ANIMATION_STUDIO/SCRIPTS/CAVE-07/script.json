{
  "id": "CAVE-07",
  "title": "The Man Who Wrote Cave Diving's Rules Tried for 1,000 ft",
  "category": "cave",
  "voice": "am_michael",
  "speed": 1.07,
  "mood": "cave",
  "target_seconds": 60,
  "lines": [
    {
      "id": "L01",
      "text": "Two divers dropped into this hole, chasing 1,000 feet.",
      "pause_after": 0.15,
      "shot": "S01",
      "emphasis": [
        "1,000",
        "feet"
      ]
    },
    {
      "id": "L02",
      "text": "Only one came back up.",
      "pause_after": 0.35,
      "shot": "S02",
      "emphasis": [
        "one"
      ]
    },
    {
      "id": "L03",
      "text": "Zacatón, Mexico. April 1994. Nobody knew how deep it went.",
      "pause_after": 0.3,
      "shot": "S03",
      "emphasis": [
        "Zacatón",
        "deep"
      ]
    },
    {
      "id": "L04",
      "text": "One diver was Jim Bowden.",
      "pause_after": 0.2,
      "shot": "S04",
      "emphasis": [
        "Bowden"
      ]
    },
    {
      "id": "L05",
      "text": "The other was Sheck Exley, a legend of cave diving.",
      "pause_after": 0.2,
      "shot": "S05",
      "emphasis": [
        "Sheck",
        "Exley"
      ]
    },
    {
      "id": "L06",
      "text": "The first person ever to log 1,000 cave dives.",
      "pause_after": 0.25,
      "shot": "S06",
      "emphasis": [
        "1,000"
      ]
    },
    {
      "id": "L07",
      "text": "His cave-diving safety manual was titled Basic Cave Diving: A Blueprint for Survival.",
      "pause_after": 0.35,
      "shot": "S07",
      "emphasis": [
        "Blueprint",
        "Survival"
      ]
    },
    {
      "id": "L08",
      "text": "They went down on separate lines, each alone in the dark.",
      "pause_after": 0.25,
      "shot": "S08",
      "emphasis": [
        "separate",
        "alone"
      ]
    },
    {
      "id": "L09",
      "text": "Around 925 feet, Bowden was burning gas faster than planned.",
      "pause_after": 0.25,
      "shot": "S09",
      "emphasis": [
        "925",
        "gas"
      ]
    },
    {
      "id": "L10",
      "text": "He turned back, and set a world depth record.",
      "pause_after": 0.5,
      "shot": "S10",
      "emphasis": [
        "record"
      ]
    },
    {
      "id": "L11",
      "text": "Exley's light never came back up.",
      "pause_after": 0.7,
      "shot": "S11",
      "emphasis": [
        "never"
      ]
    },
    {
      "id": "L12",
      "text": "Three days later, his team hauled up his line.",
      "pause_after": 0.25,
      "shot": "S12",
      "emphasis": [
        "Three",
        "days"
      ]
    },
    {
      "id": "L13",
      "text": "Exley came up with it, wrapped in the line.",
      "pause_after": 0.5,
      "shot": "S13",
      "emphasis": [
        "wrapped"
      ]
    },
    {
      "id": "L14",
      "text": "The cause of his death was never determined.",
      "pause_after": 0.3,
      "shot": "S14",
      "emphasis": [
        "never",
        "determined"
      ]
    },
    {
      "id": "L15",
      "text": "He was 45.",
      "pause_after": 0.4,
      "shot": "S15",
      "emphasis": [
        "45"
      ]
    },
    {
      "id": "L16",
      "text": "Today, cave divers can earn an award in his name.",
      "pause_after": 0.2,
      "shot": "S16",
      "emphasis": [
        "award"
      ]
    },
    {
      "id": "L17",
      "text": "It's for logging 1,000 safe cave dives.",
      "pause_after": 0.4,
      "shot": "S17",
      "emphasis": [
        "1,000",
        "safe"
      ]
    }
  ],
