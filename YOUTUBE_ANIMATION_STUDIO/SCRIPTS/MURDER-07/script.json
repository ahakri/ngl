{
  "id": "MURDER-07",
  "title": "The Oldest Cold Case: Shot in the Back 5,300 Years Ago",
  "category": "murder",
  "voice": "am_onyx",
  "speed": 1.07,
  "mood": "murder",
  "target_seconds": 72,
  "lines": [
    {
      "id": "L01",
      "text": "This cold case is 5,300 years old.",
      "pause_after": 0.2,
      "shot": "S01",
      "emphasis": [
        "5,300"
      ]
    },
    {
      "id": "L02",
      "text": "September 1991. Two German hikers spot a body melting out of a glacier.",
      "pause_after": 0.25,
      "shot": "S02",
      "emphasis": [
        "body",
        "glacier"
      ]
    },
    {
      "id": "L03",
      "text": "High in the Ötztal Alps, on the border of Italy and Austria.",
      "pause_after": 0.2,
      "shot": "S03",
      "emphasis": [
        "Ötztal"
      ]
    },
    {
      "id": "L04",
      "text": "At first, everyone assumed it was a climber who'd died recently.",
      "pause_after": 0.3,
      "shot": "S04",
      "emphasis": [
        "recently"
      ]
    },
    {
      "id": "L05",
      "text": "Then radiocarbon dating put his life around 3300 BC.",
      "pause_after": 0.25,
      "shot": "S05",
      "emphasis": [
        "3300",
        "BC"
      ]
    },
    {
      "id": "L06",
      "text": "Europe's oldest known natural human mummy. They named him Ötzi.",
      "pause_after": 0.3,
      "shot": "S06",
      "emphasis": [
        "oldest",
        "Ötzi"
      ]
    },
    {
      "id": "L07",
      "text": "He carried a copper axe, a flint dagger and an unfinished bow.",
      "pause_after": 0.25,
      "shot": "S07",
      "emphasis": [
        "copper",
        "axe",
        "bow"
      ]
    },
    {
      "id": "L08",
      "text": "But for ten years, nobody knew how he died.",
      "pause_after": 0.4,
      "shot": "S08",
      "emphasis": [
        "how",
        "died"
      ]
    },
    {
      "id": "L09",
      "text": "In 2001, a new X-ray caught something in his left shoulder.",
      "pause_after": 0.6,
      "shot": "S09",
      "emphasis": [
        "X-ray",
        "shoulder"
      ]
    },
    {
      "id": "L10",
      "text": "A flint arrowhead.",
      "pause_after": 0.3,
      "shot": "S10",
      "emphasis": [
        "arrowhead"
      ]
    },
    {
      "id": "L11",
      "text": "He'd been shot from behind.",
      "pause_after": 0.3,
      "shot": "S10",
      "emphasis": [
        "behind"
      ]
    },
    {
      "id": "L12",
      "text": "Looking back, it was visible on an X-ray from 1991.",
      "pause_after": 0.35,
      "shot": "S11",
      "emphasis": [
        "visible",
        "1991"
      ]
    },
    {
      "id": "L13",
      "text": "In 2007, new CT scans looked closer.",
      "pause_after": 0.2,
      "shot": "S12",
      "emphasis": [
        "CT"
      ]
    },
    {
      "id": "L14",
      "text": "The arrow had torn a major artery under his collarbone.",
      "pause_after": 0.25,
      "shot": "S13",
      "emphasis": [
        "artery"
      ]
    },
    {
      "id": "L15",
      "text": "Researchers concluded he most likely bled to death.",
      "pause_after": 0.4,
      "shot": "S14",
      "emphasis": [
        "bled"
      ]
    },
    {
      "id": "L16",
      "text": "Shortly before, he'd eaten a hearty meal, including ibex.",
      "pause_after": 0.3,
      "shot": "S15",
      "emphasis": [
        "ibex"
      ]
    },
    {
      "id": "L17",
      "text": "Who shot him, and why, is still unknown.",
      "pause_after": 0.5,
      "shot": "S16",
      "emphasis": [
        "Who",
        "why"
      ]
    },
    {
      "id": "L18",
      "text": "Today, he's kept on ice in a museum in Bolzano.",
      "pause_after": 0.3,
      "shot": "S17",
      "emphasis": [
        "ice",
        "Bolzano"
      ]
    }
  ],
