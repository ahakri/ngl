{
  "id": "HAUNT-10",
  "title": "The Staircase That Leads Into the Ceiling",
  "category": "haunted",
  "voice": "am_adam",
  "speed": 0.92,
  "mood": "haunted",
  "target_seconds": 48,
  "lines": [
    {
      "id": "L01",
      "text": "This staircase climbs straight into the ceiling.",
      "pause_after": 0.3,
      "shot": "S01",
      "emphasis": [
        "ceiling"
      ]
    },
    {
      "id": "L02",
      "text": "Legend says it was built to confuse ghosts.",
      "pause_after": 0.25,
      "shot": "S02",
      "emphasis": [
        "Legend",
        "ghosts"
      ]
    },
    {
      "id": "L03",
      "text": "Winchester Mystery House, San Jose, California.",
      "pause_after": 0.25,
      "shot": "S03",
      "emphasis": [
        "Winchester"
      ]
    },
    {
      "id": "L04",
      "text": "Rifle heiress Sarah Winchester bought a farmhouse here.",
      "pause_after": 0.2,
      "shot": "S04",
      "emphasis": [
        "rifle",
        "heiress"
      ]
    },
    {
      "id": "L05",
      "text": "She kept adding to it for decades, until she died in 1922.",
      "pause_after": 0.25,
      "shot": "S05",
      "emphasis": [
        "decades",
        "1922"
      ]
    },
    {
      "id": "L06",
      "text": "A medium supposedly warned her about the ghosts of Winchester rifle victims.",
      "pause_after": 0.2,
      "shot": "S06",
      "emphasis": [
        "medium",
        "ghosts"
      ]
    },
    {
      "id": "L07",
      "text": "To escape them, the story goes, she had to keep building forever.",
      "pause_after": 0.4,
      "shot": "S07",
      "emphasis": [
        "forever"
      ]
    },
    {
      "id": "L08",
      "text": "In 1906, an earthquake cut the house from seven floors to four.",
      "pause_after": 0.3,
      "shot": "S08",
      "emphasis": [
        "1906",
        "four"
      ]
    },
    {
      "id": "L09",
      "text": "And the stairs into the ceiling? Likely leftovers from remodeling.",
      "pause_after": 0.3,
      "shot": "S09",
      "emphasis": [
        "remodeling"
      ]
    },
    {
      "id": "L10",
      "text": "Her biographer, Mary Jo Ignoffo, found no evidence for the ghost story.",
      "pause_after": 0.3,
      "shot": "S10",
      "emphasis": [
        "no",
        "evidence"
      ]
    },
    {
      "id": "L11",
      "text": "Soon after she died, the house opened to paying visitors.",
      "pause_after": 0.2,
      "shot": "S11",
      "emphasis": [
        "paying"
      ]
    },
    {
      "id": "L12",
      "text": "The ghost story sold the tickets.",
      "pause_after": 1.0,
      "shot": "S12",
      "emphasis": [
        "sold"
      ]
    },
    {
      "id": "L13",
      "text": "Whatever the truth, one thing hasn't changed.",
      "pause_after": 0.2,
      "shot": "S13",
      "emphasis": [
        "truth"
      ]
    }
  ],
