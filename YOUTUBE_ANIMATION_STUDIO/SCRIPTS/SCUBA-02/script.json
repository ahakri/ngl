{
 "id": "SCUBA-02",
 "title": "The Dive Boat Left Without Them",
 "category": "scuba",
 "voice": "bm_george",
 "speed": 1.13,
 "mood": "scuba",
 "target_seconds": 58,
 "lines": [
  {
   "id": "L01",
   "text": "Two divers surfaced at the Great Barrier Reef. Their boat was gone.",
   "pause_after": 0.3,
   "shot": "S01",
   "emphasis": [
    "boat",
    "gone"
   ]
  },
  {
   "id": "L02",
   "text": "January 1998. St Crispin's Reef, off Port Douglas.",
   "pause_after": 0.2,
   "shot": "S02",
   "emphasis": [
    "1998"
   ]
  },
  {
   "id": "L03",
   "text": "Tom and Eileen Lonergan, experienced American divers.",
   "pause_after": 0.15,
   "shot": "S03",
   "emphasis": [
    "Tom",
    "Eileen",
    "Lonergan"
   ]
  },
  {
   "id": "L04",
   "text": "Before leaving, the Outer Edge crew reportedly counted heads.",
   "pause_after": 0.1,
   "shot": "S04",
   "emphasis": [
    "counted"
   ]
  },
  {
   "id": "L05",
   "text": "By one account, two other divers were counted twice.",
   "pause_after": 0.2,
   "shot": "S05",
   "emphasis": [
    "counted",
    "twice"
   ]
  },
  {
   "id": "L06",
   "text": "On paper, everyone was aboard. The boat headed home.",
   "pause_after": 0.2,
   "shot": "S06",
   "emphasis": [
    "everyone"
   ]
  },
  {
   "id": "L07",
   "text": "Nobody noticed they were missing.",
   "pause_after": 0.4,
   "shot": "S07",
   "emphasis": [
    "Nobody"
   ]
  },
  {
   "id": "L08",
   "text": "Two days later, the crew found their bag still aboard.",
   "pause_after": 0.1,
   "shot": "S08",
   "emphasis": [
    "Two",
    "days"
   ]
  },
  {
   "id": "L09",
   "text": "Inside: their wallets and passports.",
   "pause_after": 0.3,
   "shot": "S09",
   "emphasis": [
    "passports"
   ]
  },
  {
   "id": "L10",
   "text": "Only then did the search begin.",
   "pause_after": 0.2,
   "shot": "S10",
   "emphasis": [
    "search"
   ]
  },
  {
   "id": "L11",
   "text": "Searchers found their gear. Not them.",
   "pause_after": 0.3,
   "shot": "S11",
   "emphasis": [
    "Not",
    "them"
   ]
  },
  {
   "id": "L12",
   "text": "A buoyancy vest washed ashore up the coast. Then a wetsuit.",
   "pause_after": 0.2,
   "shot": "S12",
   "emphasis": [
    "wetsuit"
   ]
  },
  {
   "id": "L13",
   "text": "Months later, a dive slate, reportedly asking for rescue.",
   "pause_after": 0.5,
   "shot": "S13",
   "emphasis": [
    "slate",
    "rescue"
   ]
  },
  {
   "id": "L14",
   "text": "Tom and Eileen were never found.",
   "pause_after": 0.2,
   "shot": "S14",
   "emphasis": [
    "never",
    "found"
   ]
  },
  {
   "id": "L15",
   "text": "What happened in the water is unknown.",
   "pause_after": 0.4,
   "shot": "S15",
   "emphasis": [
    "unknown"
   ]
  },
  {
   "id": "L16",
   "text": "The skipper was acquitted. The company was fined and closed.",
   "pause_after": 0.15,
   "shot": "S16",
   "emphasis": [
    "acquitted"
   ]
  },
  {
   "id": "L17",
   "text": "Queensland tightened its rules. Divers must now be counted twice, independently.",
   "pause_after": 0.25,
   "shot": "S17",
   "emphasis": [
    "twice"
   ]
  },
  {
   "id": "L18",
   "text": "Because one wrong count is all it takes...",
   "pause_after": 0.0,
   "shot": "S18",
   "emphasis": [
    "one",
    "wrong",
    "count"
   ]
  }
 ],
