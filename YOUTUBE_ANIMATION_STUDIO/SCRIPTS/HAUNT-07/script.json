{
  "id": "HAUNT-07",
  "title": "Drivers Keep Reporting They Hit Her",
  "category": "haunted",
  "voice": "bm_george",
  "speed": 1.07,
  "mood": "haunted",
  "target_seconds": 48,
  "lines": [
    {
      "id": "L01",
      "text": "A driver says he hit a girl on this hill.",
      "pause_after": 0.1,
      "shot": "S01",
      "emphasis": [
        "hit",
        "girl"
      ]
    },
    {
      "id": "L02",
      "text": "Then she vanished.",
      "pause_after": 0.4,
      "shot": "S02",
      "emphasis": [
        "vanished"
      ]
    },
    {
      "id": "L03",
      "text": "Blue Bell Hill, Kent, on the A229 near Maidstone.",
      "pause_after": 0.25,
      "shot": "S03",
      "emphasis": [
        "Blue",
        "Bell",
        "Hill"
      ]
    },
    {
      "id": "L04",
      "text": "In 1974, a local bricklayer reported hitting a young girl here at night.",
      "pause_after": 0.25,
      "shot": "S04",
      "emphasis": [
        "1974",
        "girl"
      ]
    },
    {
      "id": "L05",
      "text": "He covered her with a blanket and went for the police.",
      "pause_after": 0.25,
      "shot": "S05",
      "emphasis": [
        "blanket",
        "police"
      ]
    },
    {
      "id": "L06",
      "text": "When he came back with officers, only the blanket was there.",
      "pause_after": 0.45,
      "shot": "S06",
      "emphasis": [
        "only",
        "blanket"
      ]
    },
    {
      "id": "L07",
      "text": "And he wasn't the last.",
      "pause_after": 0.3,
      "shot": "S07",
      "emphasis": [
        "last"
      ]
    },
    {
      "id": "L08",
      "text": "In November 1992, motorists again reported running down a young woman here.",
      "pause_after": 0.25,
      "shot": "S08",
      "emphasis": [
        "1992",
        "woman"
      ]
    },
    {
      "id": "L09",
      "text": "No trace of her was ever found.",
      "pause_after": 0.35,
      "shot": "S09",
      "emphasis": [
        "No",
        "trace"
      ]
    },
    {
      "id": "L10",
      "text": "Sceptics call it a classic folk tale, told on roads worldwide.",
      "pause_after": 0.25,
      "shot": "S10",
      "emphasis": [
        "folk",
        "tale"
      ]
    },
    {
      "id": "L11",
      "text": "Even local accounts disagree on when the sightings began.",
      "pause_after": 0.3,
      "shot": "S11",
      "emphasis": [
        "disagree"
      ]
    },
    {
      "id": "L12",
      "text": "None of these reports has ever been confirmed.",
      "pause_after": 1.2,
      "shot": "S12",
      "emphasis": [
        "confirmed"
      ]
    },
    {
      "id": "L13",
      "text": "So if someone steps into your headlights on this hill...",
      "pause_after": 0.2,
      "shot": "S13",
      "emphasis": [
        "headlights"
      ]
    }
  ],
