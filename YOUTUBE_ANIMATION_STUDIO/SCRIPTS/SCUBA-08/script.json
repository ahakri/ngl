{
  "id": "SCUBA-08",
  "title": "Shackleton's Ship Was Found a Century Later, 3 km Down",
  "category": "scuba",
  "voice": "am_adam",
  "speed": 1.02,
  "mood": "scuba",
  "target_seconds": 50,
  "lines": [
    {
      "id": "L01",
      "text": "This ship sank in 1915. You can still read its name.",
      "pause_after": 0.25,
      "shot": "S01",
      "emphasis": [
        "1915",
        "name"
      ]
    },
    {
      "id": "L02",
      "text": "It's Ernest Shackleton's Endurance, three kilometres under the Weddell Sea.",
      "pause_after": 0.3,
      "shot": "S02",
      "emphasis": [
        "Shackleton's",
        "Endurance"
      ]
    },
    {
      "id": "L03",
      "text": "Pack ice trapped it for months, then crushed it.",
      "pause_after": 0.2,
      "shot": "S03",
      "emphasis": [
        "crushed"
      ]
    },
    {
      "id": "L04",
      "text": "It sank, but all 28 men on board survived.",
      "pause_after": 0.3,
      "shot": "S04",
      "emphasis": [
        "28",
        "survived"
      ]
    },
    {
      "id": "L05",
      "text": "The ship wasn't seen again for over a century.",
      "pause_after": 0.45,
      "shot": "S05",
      "emphasis": [
        "century"
      ]
    },
    {
      "id": "L06",
      "text": "A 2019 search lost its underwater robot and was called off.",
      "pause_after": 0.3,
      "shot": "S06",
      "emphasis": [
        "2019",
        "robot"
      ]
    },
    {
      "id": "L07",
      "text": "In 2022, a new expedition went back, aboard an icebreaker.",
      "pause_after": 0.2,
      "shot": "S07",
      "emphasis": [
        "2022",
        "icebreaker"
      ]
    },
    {
      "id": "L08",
      "text": "Its underwater drone searched the seabed, three kilometres down.",
      "pause_after": 0.5,
      "shot": "S08",
      "emphasis": [
        "three",
        "kilometres"
      ]
    },
    {
      "id": "L09",
      "text": "On March 5th, it found her.",
      "pause_after": 0.5,
      "shot": "S09",
      "emphasis": [
        "found"
      ]
    },
    {
      "id": "L10",
      "text": "About four miles from the position her captain had recorded.",
      "pause_after": 0.2,
      "shot": "S10",
      "emphasis": [
        "four",
        "miles"
      ]
    },
    {
      "id": "L11",
      "text": "Upright, intact, 3,008 metres down.",
      "pause_after": 0.45,
      "shot": "S11",
      "emphasis": [
        "Upright",
        "intact"
      ]
    },
    {
      "id": "L12",
      "text": "Experts say the creatures that eat wooden wrecks elsewhere don't live in these waters.",
      "pause_after": 0.3,
      "shot": "S12",
      "emphasis": [
        "wooden"
      ]
    },
    {
      "id": "L13",
      "text": "Today it's a protected monument. Nothing may be taken.",
      "pause_after": 0.6,
      "shot": "S13",
      "emphasis": [
        "protected"
      ]
    },
    {
      "id": "L14",
      "text": "And it was found 100 years to the day after Shackleton's funeral.",
      "pause_after": 0.3,
      "shot": "S14",
      "emphasis": [
        "100",
        "funeral"
      ]
    }
  ],
