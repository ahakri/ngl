{
  "id": "CAVE-01",
  "title": "He Went 270 m Down to Bring a Body Home",
  "category": "cave",
  "voice": "am_michael",
  "speed": 1.07,
  "mood": "cave",
  "target_seconds": 67,
  "lines": [
    {
      "id": "L01",
      "text": "He found a body 270 metres down.",
      "pause_after": 0.15,
      "shot": "S01",
      "emphasis": [
        "body",
        "270"
      ]
    },
    {
      "id": "L02",
      "text": "Then he went back for it.",
      "pause_after": 0.35,
      "shot": "S02",
      "emphasis": [
        "back"
      ]
    },
    {
      "id": "L03",
      "text": "Ten minutes down. About ten hours of stops back up.",
      "pause_after": 0.3,
      "shot": "S03",
      "emphasis": [
        "Ten",
        "hours"
      ]
    },
    {
      "id": "L04",
      "text": "This is Boesmansgat, Bushman's Hole, South Africa.",
      "pause_after": 0.25,
      "shot": "S04",
      "emphasis": [
        "Boesmansgat"
      ]
    },
    {
      "id": "L05",
      "text": "In 2004, Australian pilot Dave Shaw set a depth record here.",
      "pause_after": 0.2,
      "shot": "S05",
      "emphasis": [
        "record"
      ]
    },
    {
      "id": "L06",
      "text": "At the bottom, his torch found another diver.",
      "pause_after": 0.3,
      "shot": "S06",
      "emphasis": [
        "another",
        "diver"
      ]
    },
    {
      "id": "L07",
      "text": "Deon Dreyer. Lost here in 1994, never recovered.",
      "pause_after": 0.3,
      "shot": "S07",
      "emphasis": [
        "1994"
      ]
    },
    {
      "id": "L08",
      "text": "Shaw planned one more dive, to bring him home.",
      "pause_after": 0.25,
      "shot": "S08",
      "emphasis": [
        "home"
      ]
    },
    {
      "id": "L09",
      "text": "January 2005. Don Shirley would meet him at 220 metres.",
      "pause_after": 0.2,
      "shot": "S09",
      "emphasis": [
        "220"
      ]
    },
    {
      "id": "L10",
      "text": "Shaw reached the body and began easing it into a bag.",
      "pause_after": 0.2,
      "shot": "S10",
      "emphasis": [
        "bag"
      ]
    },
    {
      "id": "L11",
      "text": "This deep, dense gas makes every breath hard work.",
      "pause_after": 0.2,
      "shot": "S11",
      "emphasis": [
        "dense",
        "breath"
      ]
    },
    {
      "id": "L12",
      "text": "His lines snagged. He worked harder. Carbon dioxide built up.",
      "pause_after": 0.7,
      "shot": "S12",
      "emphasis": [
        "snagged",
        "Carbon",
        "dioxide"
      ]
    },
    {
      "id": "L13",
      "text": "He never reached 220.",
      "pause_after": 0.4,
      "shot": "S13",
      "emphasis": [
        "never"
      ]
    },
    {
      "id": "L14",
      "text": "Shirley searched deeper, and was struck by decompression sickness. He survived.",
      "pause_after": 0.3,
      "shot": "S14",
      "emphasis": [
        "deeper",
        "survived"
      ]
    },
    {
      "id": "L15",
      "text": "Shaw's helmet camera recorded it all.",
      "pause_after": 0.2,
      "shot": "S15",
      "emphasis": [
        "camera"
      ]
    },
    {
      "id": "L16",
      "text": "Experts concluded carbon dioxide made him black out.",
      "pause_after": 0.4,
      "shot": "S16",
      "emphasis": [
        "black",
        "out"
      ]
    },
    {
      "id": "L17",
      "text": "Four days later, divers hauled up his lines.",
      "pause_after": 0.2,
      "shot": "S17",
      "emphasis": [
        "Four",
        "days"
      ]
    },
    {
      "id": "L18",
      "text": "Two bodies came up, tangled together.",
      "pause_after": 0.5,
      "shot": "S18",
      "emphasis": [
        "Two",
        "bodies"
      ]
    },
    {
      "id": "L19",
      "text": "Ten years after he was lost, Deon Dreyer came home.",
      "pause_after": 0.6,
      "shot": "S19",
      "emphasis": [
        "came",
        "home"
      ]
    }
  ],
  "shots": [
    {
